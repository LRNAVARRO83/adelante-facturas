{
  "name": "@adelante/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend Azure Functions v4 del template Adelante. Endpoints HTTP con auth Entra ID y Azure SQL via Managed Identity.",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "predev": "npm run build",
    "dev": "concurrently -k -n tsc,func -c yellow,cyan \"npm:watch\" \"func start --port 7071\"",
    "prestart": "npm run build",
    "start": "func start --port 7071",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@adelante/shared": "*",
    "@azure/functions": "^4.5.0",
    "@azure/identity": "^4.5.0",
    "jose": "^6.2.3",
    "mssql": "^11.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.17.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  }
}
