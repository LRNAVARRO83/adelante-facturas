{
  "name": "@adelante/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Tipos, schemas Zod y utilidades compartidas entre @adelante/api y @adelante/web.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tipos": {
      "types": "./dist/tipos/index.d.ts",
      "import": "./dist/tipos/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./utilidades": {
      "types": "./dist/utilidades/index.d.ts",
      "import": "./dist/utilidades/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
