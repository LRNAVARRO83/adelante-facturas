# =============================================================================
# Frontend (Vite) — variables de entorno
# =============================================================================
# Copiar a `.env` (o `.env.local`) y completar valores.
# Solo variables prefijadas con VITE_ son expuestas al bundle del cliente.

# URL del backend Azure Functions. En dev se proxea automáticamente via Vite
# a localhost:7071, así que este valor solo es relevante en producción.
VITE_API_URL=http://localhost:7071

# =============================================================================
# Autenticación Entra ID (Azure AD) — App Registration del Grupo Adelante
# =============================================================================
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=

# Scope expuesto por la API en su propia App Registration
# (formato: api://<api-client-id>/access_as_user)
VITE_AZURE_API_SCOPE=

# =============================================================================
# Modo dev de autenticación — ⚠️ NUNCA en producción
# =============================================================================
# Si DEV=true (vite dev) Y VITE_AUTH_DEV_MODE=true, MSAL queda deshabilitado
# y se usa un usuario hardcodeado (dev@adelante.cr). Permite probar el
# starter sin tener App Registration configurada en Entra ID.
#
# Doble blindaje en código: solo activable si `import.meta.env.DEV === true`,
# así que aunque alguien deje VITE_AUTH_DEV_MODE=true en un build de prod
# (`vite build`), no surte efecto.
VITE_AUTH_DEV_MODE=true
