# =============================================================================
# Variables de entorno raíz — referencia general
# =============================================================================
# Cada workspace tiene su propio .env.example con detalle:
#   - web/.env.example  (variables VITE_* para el frontend)
#   - api/local.settings.example.json  (variables del Azure Functions host)
#
# Este archivo no se carga automáticamente; sirve de índice rápido.

# --- Frontend (web/) ---
# VITE_API_URL=http://localhost:7071
# VITE_AZURE_CLIENT_ID=
# VITE_AZURE_TENANT_ID=
# VITE_AZURE_API_SCOPE=
# VITE_AUTH_DEV_MODE=false

# --- Backend (api/) ---
# SQL_SERVER=mysqladelante.database.windows.net
# SQL_DATABASE=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# NODE_ENV=development
